# ============================================================================
# SAWA United Group — Hostinger LiteSpeed / Apache Configuration
# Target path: /domains/sawa-united.net/public_html/.htaccess
# ============================================================================

DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8

ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------------
# 1. Block direct HTTP access to sensitive & configuration files
# ----------------------------------------------------------------------------
<FilesMatch "^(config(\.example)?\.php|\.env(\..*)?|\.git.*|\.htaccess|composer\.(json|lock)|package(-lock)?\.json|README.*\.md|.*\.(log|bak|sql|sh|ini|swp))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------------
# 2. HTTPS, canonical domain & clean SPA routing
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block access to hidden directories/files (except Hostinger ACME SSL verification)
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule (^|/)\. - [F,L]

  # Canonical non-www domain: www.sawa-united.net -> https://sawa-united.net
  RewriteCond %{HTTP_HOST} ^www\.sawa-united\.net$ [NC]
  RewriteRule ^ https://sawa-united.net%{REQUEST_URI} [R=301,L]

  # Force HTTPS (Hostinger LiteSpeed & reverse-proxy safe)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Serve existing static files & assets directly (index.html, assets/*, contact.php, images)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Clean SPA routes -> index.html
  RewriteRule ^(projects|privacy)/?$ /index.html [L]
</IfModule>

# ----------------------------------------------------------------------------
# 3. MIME types (explicit ES module & asset types for LiteSpeed/Apache)
# ----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
  AddType font/woff2 .woff2
</IfModule>

# ----------------------------------------------------------------------------
# 4. Security & caching headers
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Always revalidate HTML & PHP after deployments
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Long-lived immutable cache for fingerprinted JS/CSS & brand images
  <FilesMatch "\.(js|mjs|css|jpg|jpeg|png|webp|avif|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Moderate cache for metadata files
  <FilesMatch "\.(webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# 5. Compression (Gzip)
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
