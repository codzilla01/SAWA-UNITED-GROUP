# ============================================================================
# SAWA United Group — Hostinger Browser-Ready Production Configuration
# Target path: /domains/sawa-united.net/public_html/.htaccess
# ============================================================================

DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8

ErrorDocument 403 /404.html
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------------
# 1. Block direct HTTP access to sensitive, config & source/build files
# ----------------------------------------------------------------------------
<FilesMatch "^(config(\.example)?\.php|\.env(\..*)?|\.git.*|\.htaccess|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|vite\.config\.ts|README.*\.md|.*\.(log|bak|sql|sh|ini|swp|ts|tsx|mjs))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------------
# 2. HTTPS, canonical domain & SPA routing
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow Hostinger AutoSSL / Let's Encrypt verification
  RewriteRule ^\.well-known/ - [L]

  # Block hidden dotfiles/directories and dev folders if repo was cloned directly
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(src|scripts|public|dist|node_modules)(/|$) - [F,L]

  # Canonical non-www domain: www.sawa-united.net -> https://sawa-united.net
  RewriteCond %{HTTP_HOST} ^www\.sawa-united\.net$ [NC]
  RewriteRule ^ https://sawa-united.net%{REQUEST_URI} [R=301,L]

  # Force HTTPS on production domain (Hostinger LiteSpeed & Cloudflare safe)
  RewriteCond %{HTTP_HOST} ^(www\.)?sawa-united\.net$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Pass through entry point & PHP contact handler directly
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^contact\.php$ - [L]

  # Route legacy Hostinger placeholder URLs cleanly to the homepage
  RewriteRule ^(default|index)\.php$ / [R=301,L]

  # Normalize trailing slashes on SPA subpages so relative ./assets/* always resolve from root
  RewriteRule ^(projects|privacy)/+$ /$1 [R=301,L]
  RewriteRule ^(projects|privacy)(\.html)?$ index.html [L]

  # Serve all real static files directly (assets/*, favicon-192.png, og-cover.jpg, sitemap.xml, robots.txt, site.webmanifest, 404.html)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Redirect deep unknown nested paths to root so relative ./assets/* stay valid
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^[^/]+/.+ /#/404 [R=302,NE,L]

  # Fallback single-segment routes to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# ----------------------------------------------------------------------------
# 3. MIME types
# ----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/css .css
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
  AddType font/woff2 .woff2
</IfModule>

# ----------------------------------------------------------------------------
# 4. Security & caching headers
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Always revalidate HTML & PHP after deployments
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Cache static JS/CSS & brand images (versioned via ?v= query string)
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|avif|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Moderate cache for metadata files
  <FilesMatch "\.(webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# 5. Compression (Gzip)
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
